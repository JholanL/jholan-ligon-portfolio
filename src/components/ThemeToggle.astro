---
/** Light / Dark / System switch. Several can exist on a page; scripts/theme.ts keeps them in sync. */
interface Props { size?: 'sm' | 'md' }
const { size = 'sm' } = Astro.props;
const options = [
  { value: 'light', label: 'Light theme', icon: 'M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { value: 'dark', label: 'Dark theme', icon: 'M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z' },
  { value: 'system', label: 'Match system theme', icon: 'M4 5h16v11H4zM9 20h6M12 16v4' },
];
---

<div class="tt" role="group" aria-label="Color theme" data-size={size}>
  {
    options.map((o) => (
      <button type="button" class="tt__btn" data-theme-set={o.value} aria-pressed="false" aria-label={o.label} title={o.label}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.icon} /></svg>
        {size === 'md' && <span class="tt__text">{o.value[0].toUpperCase() + o.value.slice(1)}</span>}
      </button>
    ))
  }
</div>

<script>
  import '../scripts/theme';
</script>

<style>
  .tt { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px color-mix(in oklab, currentColor 22%, transparent); }
  .tt__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-width: 32px; height: 32px; padding: 0 8px; border-radius: 999px;
    color: inherit; opacity: 0.7;
    transition: background-color var(--t-fast), opacity var(--t-fast), color var(--t-fast);
  }
  .tt__btn svg { width: 16px; height: 16px; }
  .tt__btn:hover { opacity: 1; }
  .tt__btn[aria-pressed='true'] { opacity: 1; background: currentColor; }
  .tt__btn[aria-pressed='true'] svg, .tt__btn[aria-pressed='true'] .tt__text { color: var(--hdr-bg, var(--bg)); }
  .tt[data-size='md'] .tt__btn { height: 40px; padding: 0 14px; flex: 1; }
  .tt[data-size='md'] { display: flex; }
  .tt__text { font-size: 0.85rem; font-weight: 600; }
</style>
