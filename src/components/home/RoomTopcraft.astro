---
import Pic from '../Pic.astro';
import RoomParts from './RoomParts.astro';
import type { Project } from '../../lib/projects';
import { themeVars, pad } from '../../lib/projects';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const { room } = p.data;
const [ad, phone] = room.media;
const pipeline = p.data.sections.find((s) => s.type === 'pipeline');
---

<section class="room tc themed" style={themeVars(p.data.theme)} data-room={p.id} data-scheme={p.data.theme.scheme} aria-labelledby={`room-${p.id}`} data-vt-scope>
  <div class="wrap">
    <RoomParts project={p} index={index} part="placard" />

    <div class="tc__head">
      <h2 id={`room-${p.id}`} class="tc__title" data-reveal>
        <span class="visually-hidden">{p.data.name}: </span>
        {room.headline}<br /><em>{room.accent}</em>
      </h2>
      <div class="tc__copy" data-reveal style="--d:120ms">
        <p class="tc__lede">{room.text}</p>
        <ul class="tc__points" role="list">
          {room.points.map((pt) => {
            const [who, what] = pt.split(':');
            return <li><span class="label">{who}</span><span>{what}</span></li>;
          })}
        </ul>
      </div>
    </div>

    <div class="tc__stage">
      <div class="tc__ad" data-reveal="clip" data-vt-src={`cover-${p.id}`}>
        <Pic src={ad.src} alt={ad.alt} sizes="(max-width: 900px) 100vw, 75vw" lightbox={`room-${p.id}`} title="TopCraft campaign" />
      </div>
      {phone && (
        <div class="tc__phone" aria-hidden="false">
          <Pic src={phone.src} alt={phone.alt} sizes="(max-width: 900px) 40vw, 20vw" widths={[320, 480, 720]} lightbox={`room-${p.id}`} title="Worker experience" />
        </div>
      )}
    </div>

    {
      pipeline && pipeline.type === 'pipeline' && (
        <div class="tc__pipe" data-reveal>
          <p class="label tc__pipe-label">Every piece passes six stages</p>
          <ol class="tc__stages" role="list">
            {pipeline.stages.map((s, i) => (
              <li style={`--i:${i}`}>
                <span class="label">{pad(i + 1)}</span>
                <span class="tc__stage-name">{s.name}</span>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    <RoomParts project={p} index={index} part="actions" />
  </div>
</section>

<style>
  .tc { padding-block: clamp(72px, 10vw, 160px); }
  .tc__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 32px); row-gap: 32px; align-items: end; }
  .tc__title {
    grid-column: 1 / span 7;
    font-family: var(--f-brand);
    font-size: clamp(3rem, 1.4rem + 6.4vw, 8.4rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .tc__title em { font-style: italic; color: var(--accent); font-weight: 500; }
  .tc__copy { grid-column: 8 / span 5; display: grid; gap: 24px; }
  .tc__lede { font-size: var(--step-1); line-height: 1.45; }
  .tc__points { display: grid; border-top: 1px solid var(--line); }
  .tc__points li { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .tc__points .label { color: var(--accent-text); padding-top: 0.3em; }

  .tc__stage { position: relative; margin-top: clamp(48px, 7vw, 100px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 32px); }
  .tc__ad { grid-column: 1 / span 10; border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 50px 100px -50px rgba(60, 40, 10, 0.45), 0 0 0 1px var(--line); }
  .tc__phone {
    grid-column: 10 / span 3; grid-row: 1; align-self: end;
    margin-bottom: -10%;
    border-radius: 22px; overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(23, 19, 15, 0.55);
    background: #17130f;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tc__phone { animation: tc-drift linear both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
    }
  }
  @keyframes tc-drift { from { transform: translateY(14%); } to { transform: translateY(-10%); } }

  .tc__pipe { margin-top: clamp(80px, 10vw, 140px); margin-bottom: clamp(40px, 5vw, 64px); }
  .tc__pipe-label { color: var(--muted); margin-bottom: 18px; }
  .tc__stages { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); counter-reset: s; }
  .tc__stages li { position: relative; display: grid; gap: 10px; padding: 22px 16px 0 0; }
  .tc__stages li::before {
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--fg);
    transform: scaleX(0); transform-origin: left;
    transition: transform 900ms var(--ease) calc(var(--i) * 140ms + 200ms);
  }
  .tc__stages li::after { content: ''; position: absolute; left: 0; top: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .tc__pipe.is-in li::before, :global(html:not(.js)) .tc__stages li::before { transform: scaleX(1); }
  .tc__stages .label { color: var(--accent-text); }
  .tc__stage-name { font-family: var(--f-brand); font-size: var(--step-1); line-height: 1.15; }

  @media (prefers-reduced-motion: reduce) { .tc__stages li::before { transform: scaleX(1); } }

  @media (max-width: 1000px) {
    .tc__title, .tc__copy { grid-column: 1 / -1; }
    .tc__stages { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 28px; }
  }
  @media (max-width: 640px) {
    .tc__ad { grid-column: 1 / -1; }
    .tc__phone { grid-column: 8 / span 5; grid-row: 2; margin-top: -30%; margin-bottom: 0; }
    .tc__points li { grid-template-columns: 1fr; gap: 2px; }
    .tc__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
