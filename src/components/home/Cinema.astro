---
/** A full-screen dialog per film, so visitors can watch without leaving the home page. */
import FilmPlayer from '../FilmPlayer.astro';
import type { Project } from '../../lib/projects';
import { themeVars } from '../../lib/projects';

interface Props { projects: Project[] }
const withFilm = Astro.props.projects.filter((p) => p.data.film);
---

{
  withFilm.map((p) => (
    <dialog class="cinema themed" style={themeVars(p.data.theme)} aria-label={`${p.data.name} film`} data-cinema>
      <div class="cinema__bar">
        <p class="cinema__title">
          <span class="label">Now playing</span>
          <span>{p.data.name}</span>
        </p>
        <div class="cinema__actions">
          <a class="btn btn--ghost cinema__link" href={`/work/${p.id}`}>Case study</a>
          <button type="button" class="cinema__close" data-cinema-close aria-label="Close film (Esc)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </div>
      </div>
      <div class="cinema__body">
        <FilmPlayer project={p} id={`film-home-${p.id}`} variant={p.id === 'femisafe' ? 'sos' : 'ring'} />
      </div>
    </dialog>
  ))
}

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-cinema]').forEach((d) => {
    d.querySelector('[data-cinema-close]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .cinema {
    width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    opacity: 0; transition: opacity 320ms var(--ease), display 320ms allow-discrete, overlay 320ms allow-discrete;
  }
  .cinema[open] { opacity: 1; display: grid; grid-template-rows: auto 1fr; }
  @starting-style { .cinema[open] { opacity: 0; } }
  .cinema::backdrop { background: rgba(0, 0, 0, 0.6); }
  .cinema__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px var(--gutter); }
  .cinema__title { display: grid; gap: 2px; font-weight: 600; }
  .cinema__title .label { color: var(--muted); }
  .cinema__actions { display: flex; gap: 10px; align-items: center; }
  .cinema__link { min-height: 44px; }
  .cinema__close { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); }
  .cinema__close:hover { border-color: var(--fg); }
  .cinema__close svg { width: 22px; height: 22px; }
  .cinema__body { display: grid; align-content: center; padding: 0 var(--gutter) 24px; min-height: 0; overflow: auto; }
  .cinema__body :global(.film) { width: min(100%, calc((100vh - 230px) * 16 / 9), 1400px); margin-inline: auto; }
  @media (max-width: 640px) { .cinema__link { display: none; } }
</style>
