---
import { skills, evidenceLinks } from '../../data/profile';
const rowEvidence = (g: (typeof skills)[number]) => [...new Set(g.items.flatMap((i) => i.in ?? []))].map((id) => evidenceLinks[id]);
---

<section id="skills" class="home-sec skills" aria-labelledby="skills-title" data-header-theme>
  <div class="wrap">
    <header class="home-head" data-reveal>
      <p class="home-head__label label"><span>03</span>Technical skills</p>
      <h2 id="skills-title" class="home-head__title">Toolkit, <span class="serif">with receipts.</span></h2>
      <p class="home-head__intro">From my CV. <span class="skills__key"><span class="skills__dot" aria-hidden="true"></span>Marked skills</span> are used in a project on this site, listed under “Seen in”.</p>
    </header>

    <dl class="skills__list" data-reveal style="--d:80ms">
      {
        skills.map((g) => (
          <div class="skills__row">
            <dt class="label">{g.area}</dt>
            <dd class="skills__items">
              <ul role="list">
                {g.items.map((it) => (
                  <li class:list={['skills__item', { 'skills__item--proven': it.in?.length }]}>
                    {it.in?.length && <span class="skills__dot" aria-hidden="true" />}
                    {it.name}
                    {it.in?.length && <span class="visually-hidden"> (shown in {it.in.map((id) => evidenceLinks[id].label).join(', ')})</span>}
                  </li>
                ))}
              </ul>
            </dd>
            <dd class="skills__proof">
              {rowEvidence(g).length > 0 && (
                <>
                  <span class="label muted">Seen in</span>
                  {rowEvidence(g).map((e) => (
                    <a href={e.href} target={e.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{e.label}</a>
                  ))}
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills__key { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); font-weight: 600; }
  .skills__list { border-top: 1px solid var(--line); }
  .skills__row { display: grid; grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 15rem); gap: 10px 24px; align-items: center; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .skills__row dt { color: var(--accent-text); }
  .skills__items ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .skills__item {
    display: inline-flex; align-items: center; gap: 7px; padding: 5px 11px; border-radius: 999px;
    font-size: 0.88rem; line-height: 1.25; color: var(--muted); box-shadow: inset 0 0 0 1px var(--line);
  }
  .skills__item--proven { color: var(--fg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line-strong); font-weight: 500; }
  .skills__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
  .skills__proof { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font-size: 0.88rem; font-weight: 600; }
  .skills__proof a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .skills__proof a:hover { color: var(--accent-text); text-decoration-color: currentColor; }
  @media (max-width: 960px) {
    .skills__row { grid-template-columns: 8rem minmax(0, 1fr); }
    .skills__proof { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .skills__row { grid-template-columns: 1fr; gap: 8px; }
    .skills__proof { grid-column: 1; }
  }
</style>
