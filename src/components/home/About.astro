---
import { profile } from '../../data/profile';
const facts = [
  { k: 'Studying', v: `${profile.degree}, ${profile.year.toLowerCase()}`, sub: profile.school },
  { k: 'Specialization', v: profile.specialization },
  { k: 'Graduation', v: profile.graduation },
  { k: 'Looking for', v: profile.seeking },
];
---

<section id="about" class="home-sec about" aria-labelledby="about-title" data-header-theme>
  <div class="wrap about__grid">
    <header class="about__head" data-reveal>
      <p class="home-head__label label"><span>02</span>About me</p>
      <h2 id="about-title" class="home-head__title">Software that fits into <span class="serif">someone’s actual day.</span></h2>
    </header>

    <div class="about__body prose" data-reveal style="--d:80ms">
      <p>
        I’m {profile.firstName}, a {profile.year.toLowerCase()} Information Technology student at {profile.school}, specializing in mobile and web applications. I build
        software for specific people in specific places: a furniture shop owner tracking production, a call-center trainee practising a difficult call, someone heading home
        after class.
      </p>
      <p>
        I’ve worked on my own and in teams. I built <a href="/work/femisafe">FemiSafe</a> independently in Java with Android Studio. On <a href="/work/topcraft">TopCraft</a> I was
        project manager for a four-member capstone team, from the client’s requirements through features, UI and testing. On <a href="/work/voicelink">VoiceLink Academy</a> I
        worked on backend configuration, database connectivity and authentication in a team of three.
      </p>
      <p>
        I start from the user’s real situation and test what I build until it holds up. In an internship, I want to bring that care to a product team and learn how
        production software is planned, reviewed and shipped.
      </p>
    </div>

    <aside class="about__aside" data-reveal style="--d:140ms" aria-label="At a glance">
      <dl class="about__facts">
        {facts.map((f) => (
          <div>
            <dt class="label">{f.k}</dt>
            <dd>{f.v}{f.sub && <span class="muted">{f.sub}</span>}</dd>
          </div>
        ))}
      </dl>
      <p class="about__interests"><span class="label muted">Interests</span> {profile.interests.join(' · ')}</p>
    </aside>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 24px clamp(28px, 5vw, 72px); }
  .about__head { grid-column: 1 / -1; }
  .about__head .home-head__title { max-width: 22ch; }
  .about__body { font-size: var(--step-1); line-height: 1.55; display: grid; gap: 1em; }
  .about__body a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .about__body a:hover { color: var(--accent-text); text-decoration-color: currentColor; }
  .about__aside { display: grid; gap: 20px; align-content: start; padding: clamp(18px, 2vw, 24px); border-radius: var(--radius-lg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .about__facts { display: grid; gap: 14px; }
  .about__facts dt { color: var(--muted); margin-bottom: 2px; }
  .about__facts dd { font-weight: 600; line-height: 1.35; display: grid; }
  .about__facts dd .muted { font-weight: 400; font-size: var(--step--1); }
  .about__interests { font-size: var(--step--1); line-height: 1.6; padding-top: 16px; border-top: 1px solid var(--line); }
  .about__interests .label { display: block; margin-bottom: 4px; }
  @media (max-width: 860px) { .about__grid { grid-template-columns: 1fr; } }
</style>
