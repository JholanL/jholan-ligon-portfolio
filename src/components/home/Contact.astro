---
import { profile } from '../../data/profile';
const channels = [
  profile.email && { k: 'Email', v: profile.email, href: `mailto:${profile.email}`, icon: 'M4 6h16v12H4zM4 7l8 6 8-6' },
  profile.linkedin && { k: 'LinkedIn', v: profile.linkedin.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, ''), href: profile.linkedin, external: true, icon: 'M6 9v9M6 6v.01M10 18v-5a3 3 0 0 1 6 0v5M10 10v8' },
  profile.github && { k: 'GitHub', v: profile.github.replace(/^https:\/\//, ''), href: profile.github, external: true, icon: 'M9 19c-4 1.5-4-2-6-2.5m12 4.5v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.6-1.3 5.6-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.3a11.4 11.4 0 0 0-6 0C6.8 3.5 5.8 3.8 5.8 3.8a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 10c0 4.6 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.2V21' },
  profile.resume && { k: 'Résumé', v: 'Download PDF', href: profile.resume, download: 'Jholan-Ligon-CV.pdf', icon: 'M12 4v11M7 10l5 5 5-5M5 20h14' },
].filter(Boolean) as { k: string; v: string; href: string; external?: boolean; download?: string; icon: string }[];
---

<section id="contact" class="home-sec contact" aria-labelledby="contact-title" data-header-theme>
  <div class="wrap">
    <header class="contact__head" data-reveal>
      <p class="home-head__label label"><span>06</span>Contact</p>
      <h2 id="contact-title" class="contact__title">Have an internship opening? <span class="serif">Let’s talk.</span></h2>
      <p class="contact__note">
        <span class="contact__dot" aria-hidden="true"></span>{profile.year} {profile.degree} student at {profile.school} · open to a {profile.seeking.toLowerCase()}
      </p>
    </header>

    <ul class="contact__grid" role="list" data-reveal style="--d:80ms">
      {
        channels.map((c) => (
          <li>
            <a class="contact__card" href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} download={c.download}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
              <span class="label">{c.k}</span>
              <span class="contact__v">{c.v}</span>
              {c.external && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact { position: relative; overflow: clip; isolation: isolate; }
  .contact::before {
    content: ''; position: absolute; z-index: -1; left: 50%; bottom: -70vmax; translate: -50% 0;
    width: 120vmax; height: 100vmax; background: radial-gradient(closest-side, var(--glow), transparent 70%);
  }
  .contact__head { display: grid; gap: 12px; margin-bottom: clamp(24px, 3vw, 36px); }
  .contact__title { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.04em; line-height: 1; font-variation-settings: 'wdth' 110; max-width: 18ch; }
  .contact__title .serif { color: var(--accent-text); font-weight: 400; }
  .contact__note { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); font-size: var(--step--1); }
  .contact__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex: none; }
  .contact__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .contact__card {
    display: grid; gap: 4px; align-content: start; height: 100%; padding: 18px; border-radius: var(--radius-lg);
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--t-fast), transform var(--t-fast) var(--ease);
  }
  .contact__card:hover { box-shadow: inset 0 0 0 1px var(--fg); transform: translateY(-2px); }
  .contact__card svg { width: 22px; height: 22px; margin-bottom: 10px; color: var(--accent-text); }
  .contact__card .label { color: var(--muted); }
  .contact__v { font-weight: 600; overflow-wrap: anywhere; line-height: 1.35; }
  @media (max-width: 960px) { .contact__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
