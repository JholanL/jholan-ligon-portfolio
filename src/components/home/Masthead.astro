---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../../assets/profile/jholan-cutout.png';
import { profile } from '../../data/profile';
const first = 'Jholan'.split('');
const certCount = (await getCollection('certificates')).length;
---

<section class="mast" aria-labelledby="mast-title" data-header-theme>
  <div class="wrap mast__body">
    <div class="mast__text">
      <p class="mast__eyebrow label mast__rise">
        <span>{profile.role}</span><span aria-hidden="true">·</span><span>{profile.specialization.replace(' and ', ' & ')}</span>
      </p>
      <h1 id="mast-title" class="mast__name" aria-label={`${profile.name}, ${profile.role}`}>
        <span class="mast__first" data-vf aria-hidden="true">
          {first.map((ch, i) => <span class="mast__ch" style={`--i:${i}`}>{ch}</span>)}
        </span>
        <span class="mast__last serif" aria-hidden="true">Ligon</span>
      </h1>

      <p class="mast__statement mast__rise" style="--d:200ms">
        I build web and mobile software for real places: <em>a furniture workshop, a call‑center training floor, the walk home</em> and <em>the morning market.</em>
      </p>
      <p class="mast__facts mast__rise" style="--d:260ms">
        <span>{profile.year} BSIT student, {profile.school}</span>
        <span class="mast__open"><span class="mast__dot" aria-hidden="true"></span>Open to software development internships</span>
      </p>

      <div class="mast__cta mast__rise" style="--d:320ms">
        <a class="btn" href="#work">
          View projects
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
        {
          profile.resume && (
            <a class="btn btn--ghost" href={profile.resume} download="Jholan-Ligon-CV.pdf">
              Download résumé
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
            </a>
          )
        }
        <a class="btn btn--ghost" href="#contact">Contact</a>
        {certCount > 0 && <a class="mast__link" href="#certificates">See certificates <span class="mast__count">{certCount}</span></a>}
      </div>
    </div>

    <figure class="mast__portrait mast__rise" style="--d:120ms">
      <span class="mast__arch" aria-hidden="true"></span>
      <span class="mast__photo">
        <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[360, 480, 600]} sizes="(max-width: 760px) 70vw, 30vw" loading="eager" fetchpriority="high" />
      </span>
    </figure>
  </div>
</section>

<script>
  import '../../scripts/masthead';
</script>

<style>
  .mast {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(28px, 5vw, 64px));
    padding-bottom: clamp(48px, 6vw, 80px);
    overflow: clip;
    isolation: isolate;
  }
  /* A soft light from above, like a gallery spot. */
  .mast::before {
    content: '';
    position: absolute; z-index: -1;
    width: 110vmax; height: 110vmax; left: 50%; top: -72vmax; translate: -50% 0;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
  }
  .mast__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    column-gap: clamp(24px, 5vw, 72px);
    align-items: center;
  }
  .mast__text { container-type: inline-size; display: grid; align-content: center; }

  .mast__eyebrow { display: flex; flex-wrap: wrap; gap: 8px; color: var(--accent-text); margin-bottom: clamp(14px, 2vw, 22px); }

  /* The name spans its column: sized in container units. */
  .mast__name { display: grid; line-height: 0.82; font-size: 17cqi; letter-spacing: -0.035em; margin-inline: -0.04em; }
  .mast__first { display: flex; font-weight: 800; text-transform: uppercase; font-variation-settings: 'wdth' 125; }
  .mast__ch { display: inline-block; font-variation-settings: 'wdth' var(--w, 125), 'wght' var(--g, 800); font-weight: inherit; }
  .mast__last { justify-self: end; font-size: 0.82em; line-height: 0.95; margin-top: 0.02em; margin-right: 0.04em; color: var(--accent-text); }

  @media (prefers-reduced-motion: no-preference) {
    .js .mast__ch { animation: ch-in 1200ms var(--ease) both; animation-delay: calc(var(--i) * 60ms + 60ms); }
    .js .mast__last { animation: last-in 1300ms var(--ease) 420ms both; }
    .mast__rise { animation: rise 1000ms var(--ease) var(--d, 0ms) both; }
  }
  @keyframes ch-in {
    from { opacity: 0; transform: translateY(0.18em); font-variation-settings: 'wdth' 62, 'wght' 200; }
    to { opacity: 1; transform: none; font-variation-settings: 'wdth' 125, 'wght' 800; }
  }
  /* Above the fold: visible from first paint, motion is transform-only. */
  @keyframes rise { from { transform: translateY(16px); } }
  @keyframes last-in { from { opacity: 0; clip-path: inset(0 100% 0 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }

  .mast__statement {
    margin-top: clamp(22px, 3vw, 34px); max-width: 36ch;
    font-size: var(--step-2); line-height: 1.28; letter-spacing: -0.012em; font-weight: 500; font-variation-settings: 'wdth' 96;
  }
  .mast__statement em { font-family: var(--f-serif); font-style: italic; font-weight: 400; color: var(--accent-text); letter-spacing: -0.01em; }
  .mast__facts { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 16px; font-size: var(--step--1); color: var(--muted); }
  .mast__open { display: inline-flex; align-items: center; gap: 8px; color: var(--fg); font-weight: 500; }
  .mast__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px color-mix(in oklab, var(--ok) 20%, transparent); }

  .mast__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: clamp(22px, 3vw, 32px); }
  .mast__link {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding-inline: 8px;
    font-weight: 600; font-size: 0.92rem;
    text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 6px;
    transition: text-decoration-color var(--t-fast), color var(--t-fast);
  }
  .mast__link:hover { color: var(--accent-text); text-decoration-color: currentColor; }
  .mast__count {
    display: inline-grid; place-items: center; min-width: 22px; height: 22px; padding-inline: 6px; border-radius: 999px;
    font-family: var(--f-mono); font-size: 0.7rem; background: var(--glow); color: var(--accent-text);
  }

  /* Portrait: an arched alcove; the head rises just past the arch. */
  .mast__portrait { position: relative; justify-self: end; width: min(100%, 360px); aspect-ratio: 4 / 5; margin: 0; }
  .mast__arch {
    position: absolute; inset: 12% 0 0;
    border-radius: 999px 999px 24px 24px;
    background:
      radial-gradient(90% 60% at 50% 16%, color-mix(in oklab, var(--accent) 30%, transparent), transparent 70%),
      linear-gradient(to bottom, var(--surface-2), var(--surface) 90%);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 24%, transparent), var(--shadow);
  }
  .mast__photo { position: absolute; inset: 0; clip-path: inset(-30% 0 0 0 round 0 0 24px 24px); }
  .mast__photo img {
    position: absolute; left: 50%; bottom: 0; translate: -50% 0;
    width: 122%; max-width: none; height: auto;
    filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.35));
  }

  @media (max-width: 960px) {
    .mast__body { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  }
  @media (max-width: 680px) {
    .mast__body { grid-template-columns: 1fr; }
    .mast__text { display: contents; }
    /* Always two lines on phones, so the web font arriving can't change its height. */
    .mast__eyebrow { order: 1; margin-bottom: 12px; flex-direction: column; gap: 2px; }
    .mast__eyebrow > [aria-hidden] { display: none; }
    .mast__name { order: 2; font-size: calc((100vw - 2 * var(--gutter)) * 0.17); }
    .mast__portrait { order: 3; justify-self: center; width: min(66vw, 280px); margin-top: 26px; }
    .mast__statement { order: 4; font-size: 1.3rem; }
    .mast__facts { order: 5; }
    .mast__cta { order: 6; }
  }
</style>
