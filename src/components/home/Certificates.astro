---
import { getCollection } from 'astro:content';
import Pic from '../Pic.astro';

// Newest first. Add a certificate by adding a YAML file to src/content/certificates/.
// The first FEATURED show as cards; any more sit behind "Show all", which works without JS.
const FEATURED = 3;
const certs = (await getCollection('certificates')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const fileKind = (f: string) => (f.toLowerCase().endsWith('.pdf') ? 'PDF' : 'image');
const featured = certs.slice(0, FEATURED);
const more = certs.slice(FEATURED);
---

{
  certs.length > 0 && (
    <section id="certificates" class="home-sec certs" aria-labelledby="certs-title" data-header-theme>
      <div class="wrap">
        <header class="home-head" data-reveal>
          <p class="home-head__label label"><span>05</span>Certificates</p>
          <h2 id="certs-title" class="home-head__title">Certificates <span class="serif">&amp; events.</span></h2>
          <p class="home-head__intro">Hackathons, conferences and seminars, newest first. Select one to see the full certificate.</p>
        </header>

        {[featured, more].map((group, gi) =>
          group.length === 0 ? null : (
            <Fragment>
              {gi === 1 && <details class="certs__more"><summary class="btn btn--ghost">Show all {certs.length} certificates</summary></details>}
              <ol class:list={['certs__list', { 'certs__list--more': gi === 1 }]} role="list">
                {group.map((c, i) => {
                  const d = c.data;
                  const previewId = `cert-${c.id}`;
                  const date = d.dateLabel ?? fmtMonth(d.date);
                  return (
                    <li class="cert" data-reveal style={`--d:${(i % 3) * 70}ms`}>
                      <div class="cert__mat">
                        <Pic id={previewId} src={d.preview} alt={d.previewAlt} sizes="(max-width: 700px) 90vw, 30vw" widths={[360, 560, 800, 1100]} lightbox="certificates" title={d.title} caption={`${d.issuer} · ${date}`} />
                      </div>
                      <div class="cert__body">
                        <p class="cert__meta">
                          <span class="cert__cat label">{d.category}</span>
                          <time class="label" datetime={d.date.toISOString().slice(0, 10)}>{date}</time>
                        </p>
                        <h3 class="cert__title">{d.title}</h3>
                        <p class="cert__issuer">{d.issuer}</p>
                        <p class="cert__type muted">{d.type}{d.venue && <> · {d.venue}</>}</p>
                        {d.related && (
                          <a class="cert__related arrow-link" href={d.related.href}>
                            {d.related.label}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                          </a>
                        )}
                        <p class="cert__actions">
                          <a class="cert__btn" href={d.file} data-lb-open={`#${previewId}`}>View certificate<span class="visually-hidden">: {d.title}</span></a>
                          <a class="cert__link" href={d.file} target="_blank" rel="noopener">
                            Original {fileKind(d.file)} <span aria-hidden="true">↗</span>
                            <span class="visually-hidden">: {d.title} (opens in a new tab)</span>
                          </a>
                          {d.verifyUrl && <a class="cert__link" href={d.verifyUrl} target="_blank" rel="noopener">Verify <span aria-hidden="true">↗</span></a>}
                        </p>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </Fragment>
          ),
        )}
      </div>
    </section>
  )
}

<style>
  .certs__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 22px); list-style: none; padding: 0; }
  /* Extra certificates follow the "Show all" toggle; without JS, <details> alone controls them. */
  .certs__more { margin-top: 20px; }
  .certs__more summary { list-style: none; cursor: pointer; }
  .certs__more summary::-webkit-details-marker { display: none; }
  .certs__more:not([open]) + .certs__list--more { display: none; }
  .certs__more[open] { display: none; }
  .certs__list--more { margin-top: 0; }

  .cert {
    display: grid; grid-template-rows: auto 1fr; overflow: hidden;
    border-radius: var(--radius-lg); background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--t-med) var(--ease);
  }
  .cert:hover { box-shadow: inset 0 0 0 1px var(--line-strong); }
  /* The certificate rests on a mat, never cropped. */
  .cert__mat { display: grid; place-items: center; aspect-ratio: 16 / 10; padding: 16px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .cert__mat :global(.pic-link) { border-radius: 3px; box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.06); }
  .cert__mat :global(img) { max-height: 100%; width: auto; max-width: 100%; }

  .cert__body { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 16px 18px 18px; }
  .cert__meta { align-self: stretch; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px; color: var(--muted); }
  .cert__cat { color: var(--accent-text); padding: 4px 9px; border-radius: 999px; background: var(--glow); }
  .cert__title { margin-top: 4px; font-size: 1.02rem; font-weight: 700; line-height: 1.3; }
  .cert__issuer { font-size: 0.9rem; font-weight: 500; line-height: 1.4; }
  .cert__type { font-size: 0.82rem; }
  .cert__related { font-size: 0.86rem; color: var(--accent-text); margin-top: 2px; }
  .cert__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; margin-top: auto; padding-top: 10px; }
  .cert__btn {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px;
    background: var(--fg); color: var(--bg); font-weight: 600; font-size: 0.85rem;
    transition: transform var(--t-fast) var(--ease);
  }
  .cert__btn:hover { transform: translateY(-2px); }
  .cert__link { display: inline-flex; align-items: center; gap: 4px; min-height: 40px; font-size: 0.85rem; font-weight: 600; }
  .cert__link:hover { color: var(--accent-text); }

  @media (max-width: 860px) {
    .certs__list { grid-template-columns: 1fr; }
    .cert { grid-template-rows: none; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .cert__mat { aspect-ratio: auto; min-height: 100%; border-bottom: 0; border-right: 1px solid var(--line); }
  }
  @media (max-width: 560px) {
    .cert { grid-template-columns: 1fr; }
    .cert__mat { aspect-ratio: 16 / 10; border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>
