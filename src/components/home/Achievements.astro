---
import { education, achievements } from '../../data/profile';
---

<section id="education" class="home-sec ach" aria-labelledby="ach-title" data-header-theme>
  <div class="wrap">
    <header class="home-head" data-reveal>
      <p class="home-head__label label"><span>04</span>Education &amp; achievements</p>
      <h2 id="ach-title" class="home-head__title">Study, <span class="serif">and what came of it.</span></h2>
    </header>

    <div class="ach__grid">
      <div class="ach__col" data-reveal>
        <h3 class="label ach__k">Education</h3>
        <ol class="ach__list" role="list">
          {education.map((e) => (
            <li class="ach__item">
              <p class="ach__when label">{e.when}</p>
              <p class="ach__title">{e.title}</p>
              <p class="ach__detail">{e.place}</p>
              <p class="ach__detail muted">{e.detail}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="ach__col" data-reveal style="--d:80ms">
        <h3 class="label ach__k">Honors &amp; milestones</h3>
        <ul class="ach__list" role="list">
          {achievements.map((a) => (
            <li class="ach__item">
              <p class="ach__when label">{a.kind}</p>
              <p class="ach__title">{a.href ? <a href={a.href}>{a.title}</a> : a.title}</p>
              <p class="ach__detail muted">{a.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ach__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 28px clamp(28px, 5vw, 64px); }
  .ach__k { color: var(--muted); margin-bottom: 10px; }
  .ach__list { border-top: 1px solid var(--line); }
  .ach__item { display: grid; grid-template-columns: 10.5rem minmax(0, 1fr); column-gap: 18px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .ach__when { grid-row: span 3; color: var(--accent-text); padding-top: 0.3em; }
  .ach__title { font-weight: 700; line-height: 1.3; }
  .ach__title a { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 4px; }
  .ach__title a:hover { color: var(--accent-text); }
  .ach__detail { font-size: 0.92rem; line-height: 1.45; }
  @media (max-width: 900px) { .ach__grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .ach__item { grid-template-columns: 1fr; } .ach__when { grid-row: auto; margin-bottom: 2px; } }
</style>
