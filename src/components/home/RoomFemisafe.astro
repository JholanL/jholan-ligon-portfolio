---
import Rail from '../Rail.astro';
import RoomParts from './RoomParts.astro';
import type { Project } from '../../lib/projects';
import { themeVars, formatTime } from '../../lib/projects';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const { room, film } = p.data;
---

<section class="room fs themed" style={themeVars(p.data.theme)} data-room={p.id} data-scheme={p.data.theme.scheme} aria-labelledby={`room-${p.id}`} data-vt-scope>
  <div class="fs__sky" aria-hidden="true"></div>
  <div class="wrap">
    <RoomParts project={p} index={index} part="placard" />

    <div class="fs__head">
      <h2 id={`room-${p.id}`} class="fs__title" data-reveal>
        <span class="fs__brand"><span class="fs__shield" aria-hidden="true"></span>{p.data.name} <span class="label">{p.data.status}</span></span>
        {room.headline}<br /><span class="fs__soft">{room.accent}</span>
      </h2>
      <p class="fs__lede" data-reveal style="--d:120ms">{room.text}</p>
      <ul class="fs__chips" role="list" data-reveal style="--d:200ms">
        {room.points.map((pt) => <li class="chip">{pt}</li>)}
      </ul>

      {
        film && (
          <button type="button" class="fs__sos" data-film-play={`#film-home-${p.id}`} data-t="0" data-reveal style="--d:260ms">
            <span class="fs__sos-ring" aria-hidden="true">
              <span class="fs__sos-core">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
              </span>
            </span>
            <span class="fs__sos-text">
              <span class="label">Press to play the film</span>
              <span>Within Reach · {formatTime(film.duration)}</span>
            </span>
          </button>
        )
      }
    </div>

    <div class="fs__rail" data-reveal>
      <Rail items={room.media} label="FemiSafe store screenshots" group={`room-${p.id}`} variant="phones" />
    </div>

    <RoomParts project={p} index={index} part="actions" showFilm={false} />
  </div>
</section>

<style>
  .fs { position: relative; padding-block: clamp(72px, 10vw, 160px); overflow: hidden; isolation: isolate; }
  /* Dusk: violet light rising from the street, a red glow where SOS lives. */
  .fs__sky {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(124, 92, 252, 0.4), transparent 70%),
      radial-gradient(30% 30% at 50% 46%, rgba(229, 50, 75, 0.14), transparent 70%),
      linear-gradient(to bottom, var(--bg), #1d1342 22%, var(--bg) 75%);
  }
  .fs__head { display: grid; justify-items: center; text-align: center; gap: 24px; margin-bottom: clamp(56px, 7vw, 96px); }
  .fs__title { font-family: var(--f-brand); font-size: clamp(3rem, 1.2rem + 7.2vw, 9rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.045em; }
  .fs__soft { color: var(--accent-text); }
  .fs__brand { display: inline-flex; align-items: center; gap: 10px; font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 1.4rem; }
  .fs__brand .label { color: var(--muted); font-weight: 500; }
  .fs__shield { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(140deg, #8d6bff, #5b3fd6); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .fs__lede { font-size: var(--step-1); max-width: 46ch; line-height: 1.45; color: var(--fg); }
  .fs__chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .fs__chips .chip { background: rgba(255, 255, 255, 0.04); }

  .fs__sos { display: inline-flex; align-items: center; gap: 22px; margin-top: 20px; padding: 10px 28px 10px 10px; border-radius: 999px; text-align: left; transition: background-color var(--t-fast); }
  .fs__sos:hover { background: rgba(255, 255, 255, 0.05); }
  .fs__sos-ring {
    position: relative; width: 96px; height: 96px; border-radius: 50%; flex: none;
    display: grid; place-items: center;
    background: radial-gradient(circle, rgba(229, 50, 75, 0.35) 0 60%, rgba(229, 50, 75, 0.14) 61% 100%);
  }
  .fs__sos-core { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--hl); color: #fff; box-shadow: 0 10px 30px rgba(229, 50, 75, 0.5); transition: transform var(--t-med) var(--ease); }
  .fs__sos-core svg { width: 24px; height: 24px; margin-left: 3px; }
  .fs__sos:hover .fs__sos-core { transform: scale(1.08); }
  @media (prefers-reduced-motion: no-preference) {
    .fs__sos-ring::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(229, 50, 75, 0.6); animation: fs-ring 2.4s var(--ease) infinite; }
  }
  @keyframes fs-ring { from { transform: scale(0.7); opacity: 1; } to { transform: scale(1.35); opacity: 0; } }
  .fs__sos-text { display: grid; gap: 4px; }
  .fs__sos-text .label { color: var(--muted); }
  .fs__sos-text span:last-child { font-weight: 700; font-size: var(--step-1); }

  .fs__rail { margin-bottom: clamp(40px, 5vw, 64px); }
</style>
