---
import { getImage } from 'astro:assets';
import type { Project } from '../../lib/projects';
import { themeVars, pad } from '../../lib/projects';

interface Props { projects: Project[] }
const { projects } = Astro.props;

const rows = await Promise.all(
  projects.map(async (p) => ({
    p,
    thumb: await getImage({ src: p.data.cover.src, width: 240, format: 'webp', quality: 70 }),
    still: await getImage({ src: p.data.cover.src, width: 960, format: 'webp', quality: 78 }),
  })),
);
---

<section id="work" class="idx" aria-labelledby="idx-title" data-header-theme>
  <div class="wrap">
    <header class="idx__head">
      <h2 id="idx-title" class="label">The rooms<span class="muted"> · {projects.length} products, each built for a real place</span></h2>
      <p class="label muted idx__hint" aria-hidden="true">Hover to light a room</p>
    </header>

    <div class="idx__body">
      <ol class="idx__list" role="list" data-idx>
        {
          rows.map(({ p, thumb }, i) => (
            <li class="idx__row themed" style={themeVars(p.data.theme)} data-idx-row={p.id}>
              <a href={`/work/${p.id}`} class="idx__link" data-vt={`cover-${p.id}`}>
                <span class="idx__num label">{pad(i + 1)}</span>
                <img class="idx__thumb" src={thumb.src} alt="" width="120" height="68" loading="lazy" decoding="async" />
                <span class="idx__name" style={`font-family:${p.data.theme.font}`}>{p.data.name}</span>
                <span class="idx__place serif">{p.data.place}</span>
                <span class="idx__meta label">
                  {p.data.platforms.join(' + ')}
                  <span class="idx__sep">·</span>
                  {p.data.kind.split('·')[0].trim()}
                </span>
                <svg class="idx__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="idx__projector" aria-hidden="true" data-projector>
        {
          rows.map(({ p, still }, i) => (
            <div class="idx__slide" data-slide={p.id} data-active={i === 0 ? '' : undefined} style={`--slide-bg:${p.data.theme.bg}`}>
              <img src={still.src} alt="" loading="lazy" decoding="async" data-vt-src={`cover-${p.id}`} />
              {p.data.preview && <video data-src={p.data.preview} muted loop playsinline preload="none" />}
              <span class="idx__slide-tag label">{p.data.preview ? 'Real footage' : 'Campaign still'}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/room-index';
</script>

<style>
  .idx { padding-block: clamp(40px, 6vw, 96px) clamp(64px, 9vw, 140px); }
  .idx__head { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 16px; }
  .idx__head h2 { font-weight: 500; }
  .idx__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 34%); gap: clamp(24px, 3vw, 48px); align-items: start; }

  .idx__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid rgba(238, 232, 225, 0.13); }
  .idx__row { background: transparent; color: var(--bone); position: relative; border-bottom: 1px solid rgba(238, 232, 225, 0.13); isolation: isolate; }
  /* The light: the product's own colours wipe in behind the row. */
  .idx__row::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--bg);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 700ms var(--ease);
  }
  .idx__row:is(:hover, :focus-within, [data-lit])::before { clip-path: inset(0 0 0 0); }
  .idx__row:is(:hover, :focus-within, [data-lit]) { color: var(--fg); }

  .idx__link {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto auto;
    grid-template-areas: 'num name place arrow' 'num meta meta arrow';
    align-items: baseline;
    column-gap: clamp(12px, 2vw, 28px);
    row-gap: 4px;
    padding: clamp(18px, 2.4vw, 30px) clamp(8px, 1.4vw, 20px);
    outline-offset: -3px;
  }
  .idx__num { grid-area: num; color: inherit; opacity: 0.6; align-self: start; padding-top: 0.8em; }
  .idx__thumb { display: none; }
  .idx__name {
    grid-area: name;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    font-weight: 700;
    transition: letter-spacing 700ms var(--ease), transform 700ms var(--ease);
  }
  .idx__row:is(:hover, :focus-within, [data-lit]) .idx__name { transform: translateX(10px); }
  .idx__place { grid-area: place; font-size: var(--step-1); opacity: 0.85; white-space: nowrap; }
  .idx__meta { grid-area: meta; opacity: 0.6; transition: transform 700ms var(--ease); }
  .idx__row:is(:hover, :focus-within, [data-lit]) .idx__meta { transform: translateX(10px); opacity: 0.85; }
  .idx__sep { margin-inline: 0.6em; }
  .idx__arrow { grid-area: arrow; width: 28px; height: 28px; align-self: center; transition: transform 500ms var(--ease); }
  .idx__row:is(:hover, :focus-within) .idx__arrow { transform: translate(4px, -4px); color: var(--accent-text); }

  /* Projector */
  .idx__projector {
    position: sticky; top: calc(var(--header-h) + 24px);
    aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--ink-2);
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.8);
  }
  .idx__slide {
    position: absolute; inset: 0; background: var(--slide-bg);
    opacity: 0; transform: scale(1.04);
    transition: opacity 600ms var(--ease), transform 1200ms var(--ease);
  }
  .idx__slide[data-active] { opacity: 1; transform: none; }
  .idx__slide img, .idx__slide video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .idx__slide video { opacity: 0; transition: opacity 400ms var(--ease); }
  .idx__slide video[data-playing] { opacity: 1; }
  .idx__slide-tag {
    position: absolute; left: 14px; bottom: 14px; padding: 6px 10px; border-radius: 999px;
    background: rgba(14, 13, 15, 0.7); color: #eee8e1; font-size: 0.62rem;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }

  @media (max-width: 960px) {
    .idx__body { grid-template-columns: 1fr; }
    .idx__projector { display: none; }
    .idx__hint { display: none; }
    .idx__link {
      grid-template-columns: 88px minmax(0, 1fr) auto;
      grid-template-areas: 'thumb name arrow' 'thumb place arrow' 'thumb meta arrow';
      align-items: center;
    }
    .idx__num { display: none; }
    .idx__thumb { display: block; grid-area: thumb; width: 88px; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; }
    .idx__place { font-size: 1rem; }
    .idx__meta { font-size: 0.62rem; }
    .idx__name { font-size: clamp(1.6rem, 7vw, 2.4rem); }
  }
</style>
