---
/**
 * Frames a media item by kind:
 *  - screen: a raw phone capture, shown inside a simple device bezel
 *  - phone:  store art that already contains a device, shown with rounded corners
 *  - wide:   a 16:9 panel or desktop capture
 */
import Pic from './Pic.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  media: { src: ImageMetadata; alt: string; title?: string; caption?: string; kind?: 'wide' | 'phone' | 'screen' };
  sizes: string;
  group?: string;
  class?: string;
  eager?: boolean;
  vt?: string;
}
const { media, sizes, group, eager, vt } = Astro.props;
const kind = media.kind ?? 'wide';
const widths = kind === 'wide' ? [640, 960, 1280, 1600, 2200] : [320, 480, 640, 900, 1242];
---

<div class:list={['mf', `mf--${kind}`, Astro.props.class]} style={vt ? `view-transition-name:${vt}` : undefined}>
  {kind === 'screen' && <span class="mf__cam" aria-hidden="true" />}
  <Pic src={media.src} alt={media.alt} sizes={sizes} widths={widths} lightbox={group} title={media.title} caption={media.caption} eager={eager} />
</div>

<style>
  .mf { position: relative; overflow: hidden; }
  .mf--wide { border-radius: var(--radius); box-shadow: 0 0 0 1px var(--line), 0 40px 80px -40px rgba(0, 0, 0, 0.45); background: var(--surface); }
  .mf--phone { border-radius: clamp(16px, 2vw, 24px); box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.5); }
  .mf--screen {
    border-radius: clamp(26px, 3.2vw, 40px);
    padding: clamp(6px, 0.6vw, 9px);
    background: linear-gradient(145deg, #2a2a2e, #0b0b0d);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 40px 80px -30px rgba(0, 0, 0, 0.55);
  }
  .mf--screen :global(.pic-link), .mf--screen :global(img) { border-radius: clamp(20px, 2.6vw, 32px); }
  .mf__cam { position: absolute; z-index: 2; top: clamp(12px, 1.4vw, 18px); left: 50%; translate: -50% 0; width: 9px; height: 9px; border-radius: 50%; background: #050506; box-shadow: 0 0 0 2px #1d1d21; pointer-events: none; }
</style>
