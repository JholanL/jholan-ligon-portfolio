---
import MediaFrame from '../MediaFrame.astro';
import type { Project } from '../../lib/projects';
import { pad } from '../../lib/projects';

interface Props { project: Project; index: number }
const { project: p, index } = Astro.props;
const d = p.data;
const vt = `cover-${p.id}`;
// Split a two-part wordmark (TopCraft, FoodWais) at its inner capital for brand colouring.
const m = d.name.match(/^([A-Z][a-z]+)([A-Z][a-z]+)$/);
const word = m ? [m[1], m[2]] : null;
---

<header class:list={['hero', `hero--${d.hero}`]} data-room={p.id}>
  <div class="hero__fx" aria-hidden="true"></div>
  <div class="wrap hero__wrap">
    <nav class="hero__crumbs label" aria-label="Breadcrumb">
      <a href="/#work">Work</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Room {pad(index + 1)} · {d.place}</span>
    </nav>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__kind label" data-reveal="fade">{d.kind}</p>
        <h1 class="hero__title" data-reveal>
          {word ? <>{word[0]}<span class="hero__accent">{word[1]}</span></> : d.name}
        </h1>
        <p class="hero__tagline" data-reveal style="--d:80ms">{d.tagline}</p>
        <p class="hero__summary" data-reveal style="--d:140ms">{d.summary}</p>
        {
          (d.status || d.links.length > 0) && (
            <div class="hero__status" data-reveal style="--d:200ms">
              {d.status && <p class="hero__badge"><span aria-hidden="true" class="hero__dot" />{d.status}</p>}
              {d.links.map((l) => (
                <a class="arrow-link" href={l.href} target="_blank" rel="noopener">
                  {l.label}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="hero__media" data-reveal="fade" style="--d:120ms">
        <MediaFrame media={d.heroMedia} sizes={d.heroMedia.kind === 'phone' ? '(max-width: 900px) 70vw, 30vw' : '(max-width: 900px) 100vw, 60vw'} group="hero" eager vt={vt} />
      </div>
    </div>

    <dl class="hero__facts" data-reveal style="--d:200ms">
      {d.facts.map((f) => <div><dt class="label">{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
  </div>
</header>

<style>
  .hero { position: relative; padding-top: calc(var(--header-h) + clamp(20px, 3vw, 40px)); padding-bottom: clamp(56px, 7vw, 112px); overflow: clip; isolation: isolate; }
  .hero__fx { position: absolute; inset: 0; z-index: -1; }
  .hero__crumbs { display: flex; gap: 10px; color: var(--muted); margin-bottom: clamp(32px, 5vw, 72px); }
  .hero__crumbs a { min-height: 44px; display: inline-flex; align-items: center; margin-block: -14px; }
  .hero__crumbs a:hover { color: var(--fg); }

  .hero__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: center; }
  .hero__copy { display: grid; gap: 20px; align-content: center; }
  .hero__kind { color: var(--accent-text); }
  .hero__title { font-family: var(--f-brand); font-size: clamp(3.4rem, 1.2rem + 7.4vw, 9.5rem); line-height: 0.9; letter-spacing: -0.04em; font-weight: 700; }
  .hero__accent { color: var(--accent); }
  .hero__tagline { font-family: var(--f-brand); font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.015em; font-weight: 500; }
  .hero__summary { font-size: var(--step-0); color: var(--muted); max-width: 52ch; }
  .hero__status { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-top: 8px; }
  .hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); font-size: 0.88rem; }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hl); flex: none; }
  .hero__media { position: relative; }

  .hero__facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: clamp(48px, 6vw, 88px); border-top: 1px solid var(--line); }
  .hero__facts div { padding: 18px 20px 0 0; display: grid; gap: 6px; }
  .hero__facts div + div { padding-left: 20px; border-left: 1px solid var(--line); }
  .hero__facts dt { color: var(--muted); }
  .hero__facts dd { font-weight: 500; line-height: 1.35; }

  /* ---- editorial: TopCraft. A printed brochure: serif, cream, gold rules. */
  .hero--editorial .hero__grid { grid-template-columns: 1fr; gap: clamp(40px, 5vw, 72px); }
  .hero--editorial .hero__copy { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(12px, 2vw, 32px); row-gap: 18px; align-items: end; }
  .hero--editorial .hero__copy > * { grid-column: 1 / -1; }
  .hero--editorial .hero__title { grid-column: 1 / span 8; font-weight: 500; font-size: clamp(4rem, 1rem + 11vw, 13rem); letter-spacing: -0.035em; line-height: 0.85; }
  .hero--editorial .hero__accent { font-style: italic; }
  .hero--editorial .hero__tagline { grid-column: 9 / -1; font-style: italic; color: var(--accent-text); font-size: var(--step-3); align-self: end; padding-bottom: 0.4em; }
  .hero--editorial .hero__kind { grid-row: 1; }
  .hero--editorial .hero__summary { grid-column: 1 / span 6; font-size: var(--step-1); color: var(--fg); line-height: 1.45; }
  .hero--editorial .hero__fx { background: radial-gradient(70% 50% at 80% 0%, rgba(181, 135, 58, 0.18), transparent 70%); }
  .hero--editorial .hero__facts { border-top: 2px solid var(--fg); }

  /* ---- console: VoiceLink. A product UI: grid paper, tight sans, blue glow. */
  .hero--console .hero__fx {
    background:
      radial-gradient(50% 60% at 85% 20%, rgba(29, 78, 216, 0.45), transparent 70%),
      linear-gradient(rgba(185, 204, 253, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(185, 204, 253, 0.05) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .hero--console .hero__title { font-size: clamp(2.6rem, 1rem + 4.6vw, 6rem); font-weight: 600; letter-spacing: -0.035em; line-height: 0.98; }
  .hero--console .hero__accent { color: var(--accent-text); }
  .hero--console .hero__title::after { content: ''; display: block; width: 72px; height: 4px; margin-top: 0.35em; background: var(--hl); border-radius: 2px; }
  .hero--console .hero__tagline { font-size: var(--step-2); }
  .hero--console .hero__facts { border: 0; gap: 12px; }
  .hero--console .hero__facts div { padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .hero--console .hero__dot { background: var(--hl); }

  /* ---- night: FemiSafe. Dusk, centred, the phone held up to the light. */
  .hero--night .hero__fx {
    background:
      radial-gradient(45% 55% at 70% 45%, rgba(124, 92, 252, 0.45), transparent 70%),
      radial-gradient(25% 30% at 72% 60%, rgba(229, 50, 75, 0.18), transparent 70%),
      linear-gradient(to bottom, #1d1342, var(--bg));
  }
  .hero--night .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .hero--night .hero__title { font-weight: 800; letter-spacing: -0.05em; }
  .hero--night .hero__tagline { font-size: var(--step-3); font-weight: 700; letter-spacing: -0.035em; color: var(--accent-text); }
  .hero--night .hero__media { max-width: 400px; justify-self: center; width: 100%; }
  .hero--night .hero__media::before { content: ''; position: absolute; inset: 10% -20%; z-index: -1; border-radius: 50%; background: radial-gradient(closest-side, rgba(124, 92, 252, 0.6), transparent); filter: blur(10px); }
  .hero--night .hero__dot { background: #5fd38d; }
  .hero--night .hero__facts { border-top-color: rgba(196, 181, 253, 0.3); }

  /* ---- market: FoodWais. A bold, warm poster. */
  .hero--market .hero__fx { background: radial-gradient(50% 50% at 90% 10%, rgba(242, 92, 5, 0.14), transparent 70%); }
  .hero--market .hero__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .hero--market .hero__title { font-weight: 800; font-size: clamp(4rem, 1rem + 10vw, 12rem); letter-spacing: -0.06em; font-variation-settings: 'wdth' 88; line-height: 0.82; }
  .hero--market .hero__tagline { font-weight: 700; letter-spacing: -0.02em; }
  .hero--market .hero__media { max-width: 520px; justify-self: end; width: 100%; rotate: 2deg; }
  .hero--market .hero__badge { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .hero--market .hero__dot { background: var(--accent); }

  @media (max-width: 900px) {
    .hero__grid, .hero--night .hero__grid, .hero--market .hero__grid { grid-template-columns: 1fr; }
    .hero--editorial .hero__title, .hero--editorial .hero__tagline, .hero--editorial .hero__summary { grid-column: 1 / -1; }
    .hero--market .hero__media { justify-self: start; rotate: 0deg; }
    .hero--night .hero__media { max-width: 300px; justify-self: start; }
    .hero__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 18px; }
    .hero__facts div:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 480px) {
    .hero__facts { grid-template-columns: 1fr; }
    .hero__facts div + div { padding-left: 0; border-left: 0; }
    .hero--console .hero__facts { grid-template-columns: 1fr 1fr; }
  }
</style>
