---
import { Image } from 'astro:assets';
import type { Project } from '../../lib/projects';
import { themeVars } from '../../lib/projects';

interface Props { next: Project; index: number }
const { next: n, index } = Astro.props;
---

<a href={`/work/${n.id}`} class="next themed" style={themeVars(n.data.theme)} data-room={n.id} data-vt={`cover-${n.id}`} data-vt-scope>
  <div class="wrap next__inner">
    <div class="next__copy">
      <p class="label next__label">Next room · {String(index + 1).padStart(2, '0')} · {n.data.place}</p>
      <p class="next__name" style={`font-family:${n.data.theme.font}`}>{n.data.name}</p>
      <p class="next__tag">{n.data.tagline}</p>
    </div>
    <div class="next__media" data-vt-src={`cover-${n.id}`}>
      <Image src={n.data.cover.src} alt="" widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 40vw" loading="lazy" />
    </div>
    <span class="next__arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </div>
</a>

<style>
  .next { display: block; padding-block: clamp(64px, 9vw, 140px); overflow: hidden; }
  .next__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) auto; gap: clamp(24px, 4vw, 64px); align-items: center; }
  .next__copy { display: grid; gap: 12px; }
  .next__label { color: var(--accent-text); }
  .next__name { font-size: clamp(3rem, 1rem + 7vw, 8.5rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.04em; transition: transform 800ms var(--ease); }
  .next:hover .next__name { transform: translateX(12px); }
  .next__tag { color: var(--muted); font-size: var(--step-1); }
  .next__media { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16 / 10; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.5); }
  .next__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1200ms var(--ease); }
  .next:hover .next__media img { transform: scale(1.04); }
  .next__arrow { display: grid; place-items: center; width: clamp(64px, 7vw, 104px); aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line); transition: background-color var(--t-med), color var(--t-med), transform var(--t-med) var(--ease); }
  .next__arrow svg { width: 40%; }
  .next:hover .next__arrow { background: var(--accent); color: var(--on-accent); border-color: var(--accent); transform: translateX(6px); }
  @media (max-width: 800px) {
    .next__inner { grid-template-columns: 1fr; }
    .next__arrow { display: none; }
  }
</style>
