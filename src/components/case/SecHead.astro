---
interface Props { num: number; label: string; title: string; intro?: string; id?: string }
const { num, label, title, intro, id } = Astro.props;
---

<header class="sh">
  <p class="sh__label label" data-reveal="fade"><span>{String(num).padStart(2, '0')}</span>{label}</p>
  <h2 class="sh__title" id={id} data-reveal>{title}</h2>
  {intro && <p class="sh__intro" data-reveal style="--d:80ms">{intro}</p>}
</header>

<style>
  .sh { display: grid; gap: 16px; margin-bottom: clamp(32px, 4.5vw, 64px); max-width: 64rem; }
  .sh__label { display: flex; gap: 14px; color: var(--muted); }
  .sh__label span { color: var(--accent-text); }
  .sh__title { font-family: var(--f-brand); font-size: var(--step-4); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .sh__intro { color: var(--muted); max-width: 58ch; font-size: var(--step-1); line-height: 1.45; }
  :global(.case--editorial) .sh__title { font-weight: 500; }
  :global(.case--night) .sh__title, :global(.case--market) .sh__title { font-weight: 800; letter-spacing: -0.045em; }
</style>
