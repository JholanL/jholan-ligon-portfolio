---
import { profile } from '../data/profile';
import { getProjects } from '../lib/projects';
const projects = await getProjects();
const year = new Date().getFullYear();
const contacts = [
  profile.email && { label: 'Email', href: `mailto:${profile.email}` },
  profile.github && { label: 'GitHub', href: profile.github },
  profile.linkedin && { label: 'LinkedIn', href: profile.linkedin },
  profile.resume && { label: 'Résumé', href: profile.resume },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="ftr" data-header-theme>
  <div class="wrap ftr__grid">
    <div class="ftr__id">
      <p class="ftr__name">{profile.name}</p>
      <p class="muted">{profile.role} · {profile.specialization}<br />{profile.year} BSIT, {profile.school}</p>
    </div>
    <nav aria-label="Projects" class="ftr__col">
      <p class="label muted">Projects</p>
      <ul role="list">
        {projects.map((p) => <li><a href={`/work/${p.id}`}>{p.data.name}</a></li>)}
      </ul>
    </nav>
    <div class="ftr__col">
      <p class="label muted">Elsewhere</p>
      <ul role="list">
        {contacts.map((c) => <li><a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.label}</a></li>)}
      </ul>
    </div>
    <a href="#main" class="ftr__top label">Back to top ↑</a>
  </div>
  <div class="wrap ftr__base">
    <p>© {year} {profile.name}</p>
    <p>Built with Astro. Each product is shown in its own brand.</p>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--line); padding-block: clamp(40px, 5vw, 64px) 28px; background: var(--bg); }
  .ftr__grid { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 40px; align-items: start; }
  .ftr__name { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.02em; font-variation-settings: 'wdth' 118; line-height: 1.1; margin-bottom: 10px; }
  .ftr__col ul { list-style: none; padding: 0; display: grid; gap: 6px; margin-top: 14px; }
  .ftr__col a { display: inline-flex; min-height: 32px; align-items: center; }
  .ftr__col a:hover { color: var(--accent-text); }
  .ftr__top { min-height: 44px; display: inline-flex; align-items: center; }
  .ftr__top:hover { color: var(--accent-text); }
  .ftr__base { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 820px) {
    .ftr__grid { grid-template-columns: 1fr 1fr; }
    .ftr__id { grid-column: 1 / -1; }
  }
</style>
