---
import { profile } from '../data/profile';
const path = Astro.url.pathname;
const onHome = path === '/' || path === '';
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="hdr" data-hdr>
  <div class="hdr__inner">
    <a href="/" class="hdr__mark">
      <span class="hdr__mono" aria-hidden="true">JL</span>
      <span class="hdr__name">{profile.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <p class="hdr__status">
      <span class="hdr__dot" aria-hidden="true"></span>
      {onHome ? 'Open to internships' : <a href="/#contact">Open to internships</a>}
    </p>
  </div>
</header>

<style>
  .hdr {
    --hdr-bg: var(--ink);
    --hdr-fg: var(--bone);
    --hdr-accent: var(--rose);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--hdr-fg);
    transition: transform var(--t-med) var(--ease), color var(--t-med) var(--ease);
  }
  .hdr::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--hdr-bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid color-mix(in oklab, var(--hdr-fg) 10%, transparent);
    opacity: 0;
    transition: opacity var(--t-med) var(--ease), background-color var(--t-med) var(--ease);
  }
  .hdr[data-scrolled]::before { opacity: 1; }
  .hdr[data-hidden] { transform: translateY(-100%); }
  .hdr:focus-within { transform: none; }

  .hdr__inner {
    position: relative;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .hdr__mark { display: inline-flex; align-items: center; gap: 12px; justify-self: start; min-height: 44px; }
  .hdr__mono {
    display: grid; place-items: center;
    width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid currentColor;
    font-family: var(--f-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em;
    transition: background-color var(--t-fast), color var(--t-fast);
  }
  .hdr__mark:hover .hdr__mono { background: var(--hdr-fg); color: var(--hdr-bg); }
  .hdr__name { font-weight: 600; letter-spacing: -0.01em; font-variation-settings: 'wdth' 110; }

  nav ul { display: flex; gap: clamp(4px, 2vw, 28px); list-style: none; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: 8px;
    font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
    position: relative;
  }
  nav a::after {
    content: ''; position: absolute; left: 8px; right: 8px; bottom: 10px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: right;
    transition: transform var(--t-med) var(--ease);
  }
  nav a:hover::after { transform: scaleX(1); transform-origin: left; }

  .hdr__status {
    justify-self: end; display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .hdr__dot {
    width: 8px; height: 8px; border-radius: 50%; background: #5fd38d;
    box-shadow: 0 0 0 0 rgba(95, 211, 141, 0.6);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(95, 211, 141, 0); } 100% { box-shadow: 0 0 0 0 rgba(95, 211, 141, 0); } }

  @media (max-width: 760px) {
    .hdr__status { display: none; }
    .hdr__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .hdr__inner { grid-template-columns: auto 1fr; }
    nav { justify-self: end; }
    nav ul { gap: 0; }
  }
</style>
