---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
import ChatAssistant from '../components/ChatAssistant.astro';
import { profile } from '../data/profile';
import archivoWoff from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import newsreaderWoff from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  /** absolute or root-relative URL of the social preview image */
  image?: string;
  /** JSON-LD object for this page */
  schema?: Record<string, unknown>;
  /** preload the display fonts (pages whose first screen is set in them) */
  preloadFonts?: boolean;
}

const { title, description, image = '/og.png', schema, preloadFonts = false } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL(image, site).href : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Theme before first paint: stored choice, else the OS preference. Mirrors scripts/theme.ts. -->
    <script is:inline>
      (function () {
        var p = null;
        try { p = localStorage.getItem('theme'); } catch (e) {}
        if (p !== 'light' && p !== 'dark') p = 'system';
        var t = p === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : p;
        var d = document.documentElement;
        d.dataset.theme = t; d.dataset.themePref = p; d.style.colorScheme = t;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0e0d0f" />
    <script is:inline>if (document.documentElement.dataset.theme === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f6f2ec');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoWoff} as="font" type="font/woff2" crossorigin />
    {preloadFonts && <link rel="preload" href={newsreaderWoff} as="font" type="font/woff2" crossorigin />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Opt in to cross-page transitions before any stylesheet loads. -->
    <style is:inline>@view-transition { navigation: auto; }</style>
    <script is:inline>
      document.documentElement.classList.add('js');
      // A page transition can be skipped by the browser; navigation still completes. pagereveal
      // fires before module scripts run, so its promises are handled here.
      addEventListener('pagereveal', function (e) {
        var v = e.viewTransition;
        if (v) [v.ready, v.finished, v.updateCallbackDone].forEach(function (p) { p && p.catch(function () {}); });
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <ChatAssistant />
    <Lightbox />
    <script>
      import '../scripts/core';
    </script>
  </body>
</html>
