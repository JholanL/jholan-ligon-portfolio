---
import Base from '../layouts/Base.astro';
import Masthead from '../components/home/Masthead.astro';
import ProjectExplorer from '../components/home/ProjectExplorer.astro';
import About from '../components/home/About.astro';
import Skills from '../components/home/Skills.astro';
import Achievements from '../components/home/Achievements.astro';
import Certificates from '../components/home/Certificates.astro';
import Contact from '../components/home/Contact.astro';
import Cinema from '../components/home/Cinema.astro';
import { getProjects } from '../lib/projects';
import { profile } from '../data/profile';

const projects = await getProjects();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Software developer (student)',
  email: `mailto:${profile.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.school },
  knowsAbout: profile.interests,
  sameAs: [profile.github, profile.linkedin].filter(Boolean),
};
---

<Base
  title={`${profile.name} · Software developer`}
  description={`${profile.name} is a ${profile.year.toLowerCase()} BS Information Technology student at ${profile.school} building web and mobile software: TopCraft, VoiceLink Academy, FemiSafe and FoodWais. Open to software development internships.`}
  schema={schema}
  preloadFonts
>
  <Masthead />
  <ProjectExplorer projects={projects} />
  <About />
  <Skills />
  <Achievements />
  <Certificates />
  <Contact />
  <Cinema projects={projects} />
</Base>
